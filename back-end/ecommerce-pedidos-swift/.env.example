# Modelo das variáveis de conexão do back-end.
# 1. Copie este arquivo para ".env" nesta mesma pasta (o .env NÃO vai para o Git).
# 2. Preencha DB_PASSWORD com a SUA senha local.
# Variáveis definidas no terminal têm prioridade sobre o .env.

# Opcional no perfil dev (padrão: localhost:3306/ecommerce_swift).
# Exemplo com MySQL em outra porta:
# DB_URL=jdbc:mysql://localhost:3307/ecommerce_swift?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

DB_USERNAME=root
DB_PASSWORD=
